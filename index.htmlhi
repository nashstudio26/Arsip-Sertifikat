<!DOCTYPE html>
<html lang="id" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Koleksi Sertifikat & Dokumentasi</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        /* Scrollbar styling */
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #334155;
        }

        /* Frame Effect */
        .gallery-frame {
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(0, 0, 0, 0.08);
        }
        .dark .gallery-frame {
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.1);
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .cert-aspect {
            aspect-ratio: 1.414 / 1;
        }

        /* Instant Hardware-Accelerated Backdrop Blur */
        .modal-container {
            will-change: opacity, transform;
        }
    </style>
</head>
<body class="bg-[#FAFAFA] dark:bg-[#09090B] text-zinc-800 dark:text-zinc-100 min-h-screen transition-colors duration-200 antialiased pb-20">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-30 bg-[#FAFAFA]/80 dark:bg-[#09090B]/80 backdrop-blur-md border-b border-zinc-200/80 dark:border-zinc-800/80 transition-colors duration-200">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
            
            <!-- Brand Logo & Title -->
            <div class="flex items-center gap-3">
                <img src="https://lh3.googleusercontent.com/d/1vq1VfVngv9AR1H39I2YOV5_XBvhmXTfX" 
                     alt="Logo Website" 
                     onerror="this.onerror=null; this.src='https://placehold.co/100x100/18181b/ffffff?text=NS';"
                     class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg object-cover border border-zinc-200 dark:border-zinc-800 shadow-xs">
                <div>
                    <h1 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100 leading-none">Arsip Sertifikat</h1>
                    <p class="text-[11px] text-zinc-500 dark:text-zinc-400 font-medium mt-1 hidden sm:block">Koleksi Lisensi & Penghargaan</p>
                </div>
            </div>

            <!-- Header Controls -->
            <div class="flex items-center gap-1.5 sm:gap-2">
                <!-- Counter Badge -->
                <span id="certCounter" class="text-xs font-semibold px-2.5 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700/60 mr-1">
                    0 Sertifikat
                </span>

                <!-- About Icon Button -->
                <button id="aboutToggleBtn" title="Tentang Website" class="p-2 rounded-lg text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200/60 dark:hover:bg-zinc-800/80 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </button>

                <!-- Dark/Light Theme Toggle Button -->
                <button id="themeToggleBtn" title="Ganti Mode Gelap/Terang" class="p-2 rounded-lg text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200/60 dark:hover:bg-zinc-800/80 transition-colors">
                    <svg id="sunIcon" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                    </svg>
                    <svg id="moonIcon" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-3 sm:px-6 pt-3 sm:pt-4">
        <!-- Compact Section Title & Search -->
        <div class="mb-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
                <p class="text-[10px] uppercase tracking-widest font-bold text-zinc-400 dark:text-zinc-500 leading-none">Portfolio & Qualifications</p>
                <h2 class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-zinc-100 tracking-tight mt-0.5">Dokumentasi & Sertifikasi</h2>
            </div>

            <!-- Search Bar -->
            <div class="relative w-full sm:w-60">
                <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <input type="text" id="searchInput" placeholder="Cari sertifikat..." class="w-full pl-9 pr-3 py-1.5 text-xs rounded-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-400 dark:focus:ring-zinc-600 transition">
            </div>
        </div>

        <!-- Filter Category Pills -->
        <div class="mb-4 overflow-x-auto no-scrollbar pb-1">
            <div id="categoryContainer" class="flex items-center gap-1.5 min-w-max">
                <!-- Dynamically populated categories -->
            </div>
        </div>

        <!-- 
            Grid Layout:
            Mobile (<768px): Strictly 2 columns
            Desktop: 3 to 5 columns
        -->
        <div id="galleryGrid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-2.5 sm:gap-4">
            <!-- Cards populated dynamically -->
        </div>

        <!-- Empty Search State -->
        <div id="emptyState" class="hidden text-center py-16 px-4">
            <svg class="w-12 h-12 mx-auto text-zinc-300 dark:text-zinc-700 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <p class="text-sm font-medium text-zinc-600 dark:text-zinc-400">Tidak ada sertifikat yang ditemukan</p>
            <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-1">Coba kata kunci atau kategori lain</p>
        </div>
    </main>

    <!-- Floating Action Button (Ask Question) -->
    <button id="fabBtn" title="Tanyakan Sesuatu" class="fixed bottom-5 right-5 z-40 bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-900 p-3.5 rounded-full shadow-xl transition-all duration-200 transform hover:scale-105 active:scale-95 flex items-center justify-center border border-zinc-700/20 dark:border-zinc-300/20">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
        </svg>
    </button>

    <!-- Modal 1: Certificate Preview Popup (Instant Blur, Compact Vertical Height) -->
    <div id="certModal" class="modal-container fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-5 opacity-0 pointer-events-none transition-opacity duration-150 ease-out">
        <div id="modalBackdrop" class="absolute inset-0 bg-black/60 dark:bg-black/80 backdrop-blur-md"></div>

        <div class="relative w-[92vw] sm:w-[85vw] lg:w-[75vw] max-w-5xl h-auto max-h-[65vh] bg-white dark:bg-[#121215] rounded-2xl gallery-frame flex flex-col overflow-hidden z-10 transition-transform duration-150 transform scale-95 shadow-2xl border border-zinc-200/80 dark:border-zinc-800">
            
            <!-- Modal Header -->
            <div class="px-4 py-2.5 sm:px-5 sm:py-3 border-b border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between bg-zinc-50/50 dark:bg-zinc-900/50 shrink-0">
                <div class="pr-4 overflow-hidden">
                    <span id="modalCategory" class="inline-block px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-600 dark:text-zinc-300 bg-zinc-200/60 dark:bg-zinc-800 rounded mb-0.5">
                        Kategori
                    </span>
                    <h3 id="modalTitle" class="text-xs sm:text-sm font-semibold text-zinc-900 dark:text-zinc-100 truncate leading-tight">
                        Judul Sertifikat
                    </h3>
                </div>

                <button id="closeModalBtn" aria-label="Tutup Popup" class="p-1.5 rounded-full text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-200/60 dark:hover:bg-zinc-800 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <!-- Certificate Image Container (Compact Padding to eliminate empty top/bottom) -->
            <div class="flex-1 min-h-0 p-2 sm:p-4 bg-zinc-100/60 dark:bg-[#0B0B0D] flex items-center justify-center overflow-auto">
                <div class="relative max-w-full max-h-full p-1.5 bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200/70 dark:border-zinc-800 shadow-md flex items-center justify-center">
                    <div id="modalLoader" class="absolute inset-0 flex items-center justify-center bg-white/80 dark:bg-zinc-900/80 z-10 rounded-lg">
                        <div class="w-7 h-7 border-2 border-zinc-300 border-t-zinc-800 dark:border-zinc-700 dark:border-t-zinc-200 rounded-full animate-spin"></div>
                    </div>
                    <img id="modalImage" src="" alt="Detail Sertifikat" class="max-w-full max-h-[48vh] sm:max-h-[50vh] object-contain rounded select-none">
                </div>
            </div>

            <!-- Modal Footer (Clean & Centered) -->
            <div class="px-4 py-2 border-t border-zinc-100 dark:border-zinc-800/80 bg-white dark:bg-[#121215] flex items-center justify-center text-[10px] sm:text-[11px] text-zinc-400 dark:text-zinc-500 font-medium tracking-wide shrink-0">
                Developed by Nash Studio
            </div>
        </div>
    </div>

    <!-- Modal 2: About Website Popup -->
    <div id="aboutModal" class="modal-container fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-150 ease-out">
        <div id="aboutBackdrop" class="absolute inset-0 bg-black/60 dark:bg-black/80 backdrop-blur-md"></div>

        <div class="relative w-full max-w-md bg-white dark:bg-[#121215] rounded-2xl gallery-frame p-5 sm:p-6 z-10 transition-transform duration-150 transform scale-95 shadow-2xl border border-zinc-200/80 dark:border-zinc-800">
            <!-- Close Button -->
            <button id="closeAboutBtn" aria-label="Tutup Modal About" class="absolute top-4 right-4 p-1.5 rounded-full text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>

            <!-- Header -->
            <div class="flex items-center gap-3 mb-4">
                <img src="https://lh3.googleusercontent.com/d/1vq1VfVngv9AR1H39I2YOV5_XBvhmXTfX" 
                     alt="Nash Studio Logo" 
                     onerror="this.onerror=null; this.src='https://placehold.co/100x100/18181b/ffffff?text=NS';"
                     class="w-11 h-11 rounded-xl object-cover border border-zinc-200 dark:border-zinc-800">
                <div>
                    <h3 id="aboutTitle" class="text-base font-bold text-zinc-900 dark:text-zinc-100">Tentang Website Ini</h3>
                    <p id="aboutSubtitle" class="text-xs text-zinc-500 dark:text-zinc-400 font-medium">Nash Studio Official Archive</p>
                </div>
            </div>

            <!-- Dynamic Description Body -->
            <div id="aboutDescription" class="text-xs leading-relaxed text-zinc-600 dark:text-zinc-300 space-y-2.5 mb-5 border-b border-zinc-100 dark:border-zinc-800/80 pb-4">
                <!-- Dynamically populated from data.json -->
            </div>

            <!-- Visitor Statistics Section -->
            <div>
                <h4 class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-2.5">
                    Statistik Pengunjung
                </h4>
                <div class="grid grid-cols-3 gap-2 text-center">
                    <div class="bg-zinc-50 dark:bg-zinc-900/90 border border-zinc-200/70 dark:border-zinc-800 rounded-xl p-2.5">
                        <span id="statWeekly" class="block text-base font-extrabold text-zinc-900 dark:text-zinc-100">0</span>
                        <span class="text-[10px] text-zinc-500 dark:text-zinc-400 font-medium">Minggu Ini</span>
                    </div>
                    <div class="bg-zinc-50 dark:bg-zinc-900/90 border border-zinc-200/70 dark:border-zinc-800 rounded-xl p-2.5">
                        <span id="statMonthly" class="block text-base font-extrabold text-zinc-900 dark:text-zinc-100">0</span>
                        <span class="text-[10px] text-zinc-500 dark:text-zinc-400 font-medium">Bulan Ini</span>
                    </div>
                    <div class="bg-zinc-50 dark:bg-zinc-900/90 border border-zinc-200/70 dark:border-zinc-800 rounded-xl p-2.5">
                        <span id="statYearly" class="block text-base font-extrabold text-zinc-900 dark:text-zinc-100">0</span>
                        <span class="text-[10px] text-zinc-500 dark:text-zinc-400 font-medium">Tahun Ini</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal 3: Contact / Ask Question Popup (WhatsApp) -->
    <div id="contactModal" class="modal-container fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-150 ease-out">
        <div id="contactBackdrop" class="absolute inset-0 bg-black/60 dark:bg-black/80 backdrop-blur-md"></div>

        <div class="relative w-full max-w-sm bg-white dark:bg-[#121215] rounded-2xl gallery-frame p-5 sm:p-6 z-10 transition-transform duration-150 transform scale-95 shadow-2xl border border-zinc-200/80 dark:border-zinc-800">
            <!-- Close Button -->
            <button id="closeContactBtn" aria-label="Tutup Form Pertanyaan" class="absolute top-4 right-4 p-1.5 rounded-full text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>

            <div class="mb-4">
                <h3 class="text-base font-bold text-zinc-900 dark:text-zinc-100">Tanyakan Sesuatu</h3>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 font-medium mt-0.5">Kirim pesan langsung ke WhatsApp Nash Studio</p>
            </div>

            <!-- Form -->
            <form id="whatsappForm" class="space-y-3.5">
                <div>
                    <label for="senderName" class="block text-[11px] font-semibold text-zinc-700 dark:text-zinc-300 mb-1">
                        Nama (Opsional / Samaran)
                    </label>
                    <input type="text" id="senderName" placeholder="Contoh: Hamba Allah / Nashrul" class="w-full px-3 py-2 text-xs rounded-lg bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-400 dark:focus:ring-zinc-600 transition">
                </div>

                <div>
                    <label for="senderMessage" class="block text-[11px] font-semibold text-zinc-700 dark:text-zinc-300 mb-1">
                        Pertanyaan <span class="text-red-500">*</span>
                    </label>
                    <textarea id="senderMessage" rows="3" required placeholder="Tuliskan pertanyaan atau pesanmu di sini..." class="w-full px-3 py-2 text-xs rounded-lg bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-400 dark:focus:ring-zinc-600 transition resize-none"></textarea>
                </div>

                <button type="submit" class="w-full py-2.5 px-4 bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-900 text-xs font-bold rounded-xl shadow-md transition-colors flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                    </svg>
                    Kirim via WhatsApp
                </button>
            </form>
        </div>
    </div>

    <script>
        // Default Embedded Data Fallback
        const DEFAULT_DATA = {
            stats: {
                weekly: 1420,
                monthly: 5830,
                yearly: 42150
            },
            about: {
                title: "Tentang Website Ini",
                subtitle: "Nash Studio Official Archive",
                description: [
                    "Website ini adalah kumpulan arsip sertifikat yang dikumpulkan sejak tahun <strong>2022</strong> dengan berbagai kategori kualifikasi.",
                    "Diluncurkan oleh <strong>Nash Studio</strong> (<strong>Muhadzdzib Nashrulloh</strong>, <em>a.k.a Nashrul</em>), mahasiswa semester 7 di <strong>STDI Imam Syafi'i Jember</strong>."
                ]
            },
            certificates: [
                {
                    id: "cert-1",
                    title: "Sertifikat Pemahaman & Studi Islam",
                    category: "Islam",
                    imageUrl: "https://lh3.googleusercontent.com/d/1sRXSvHwwRcEx_zv9f21NtJvHNyodOgrq",
                    date: "2024"
                },
                {
                    id: "cert-2",
                    title: "Sertifikat Kemampuan Bahasa & Komunikasi",
                    category: "Bahasa",
                    imageUrl: "https://lh3.googleusercontent.com/d/15nbyeJJR27Pf90t9of662JJUBXpptDag",
                    date: "2024"
                },
                {
                    id: "cert-3",
                    title: "Sertifikat Kualifikasi Karya Tulis Ilmiah",
                    category: "Karya Ilmiah",
                    imageUrl: "https://lh3.googleusercontent.com/d/1bccfex3tM1OqslawJZyre1oo0j9K4-rv",
                    date: "2023"
                },
                {
                    id: "cert-4",
                    title: "Sertifikat Kewirausahaan & Business Plan",
                    category: "Enterpreneur",
                    imageUrl: "https://lh3.googleusercontent.com/d/1fY5ts9IpJio-r3OVSNGAVaGJROSaPT1L",
                    date: "2023"
                }
            ]
        };

        // State Management
        let certificates = [];
        let siteStats = { weekly: 0, monthly: 0, yearly: 0 };
        let siteAbout = DEFAULT_DATA.about;
        let activeCategory = "Semua";
        let searchQuery = "";

        // DOM Elements
        const galleryGrid = document.getElementById('galleryGrid');
        const categoryContainer = document.getElementById('categoryContainer');
        const searchInput = document.getElementById('searchInput');
        const emptyState = document.getElementById('emptyState');
        const certCounter = document.getElementById('certCounter');

        // Certificate Modal Elements
        const certModal = document.getElementById('certModal');
        const modalBackdrop = document.getElementById('modalBackdrop');
        const closeModalBtn = document.getElementById('closeModalBtn');
        const modalTitle = document.getElementById('modalTitle');
        const modalCategory = document.getElementById('modalCategory');
        const modalImage = document.getElementById('modalImage');
        const modalLoader = document.getElementById('modalLoader');

        // About Modal Elements
        const aboutModal = document.getElementById('aboutModal');
        const aboutBackdrop = document.getElementById('aboutBackdrop');
        const aboutToggleBtn = document.getElementById('aboutToggleBtn');
        const closeAboutBtn = document.getElementById('closeAboutBtn');
        const aboutTitle = document.getElementById('aboutTitle');
        const aboutSubtitle = document.getElementById('aboutSubtitle');
        const aboutDescription = document.getElementById('aboutDescription');

        // Contact Modal Elements
        const fabBtn = document.getElementById('fabBtn');
        const contactModal = document.getElementById('contactModal');
        const contactBackdrop = document.getElementById('contactBackdrop');
        const closeContactBtn = document.getElementById('closeContactBtn');
        const whatsappForm = document.getElementById('whatsappForm');

        // Theme Toggle Logic
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        
        function initTheme() {
            const savedTheme = localStorage.getItem('app-theme');
            if (savedTheme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        }

        themeToggleBtn.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('app-theme', isDark ? 'dark' : 'light');
        });

        // Load JSON Data
        async function loadCertificates() {
            try {
                const response = await fetch('data.json');
                if (!response.ok) throw new Error('data.json not found');
                const rawData = await response.json();

                if (Array.isArray(rawData)) {
                    certificates = rawData;
                    siteStats = DEFAULT_DATA.stats;
                    siteAbout = DEFAULT_DATA.about;
                } else {
                    certificates = rawData.certificates || DEFAULT_DATA.certificates;
                    siteStats = rawData.stats || DEFAULT_DATA.stats;
                    siteAbout = rawData.about || DEFAULT_DATA.about;
                }
            } catch (error) {
                console.warn('Using embedded default dataset:', error);
                certificates = DEFAULT_DATA.certificates;
                siteStats = DEFAULT_DATA.stats;
                siteAbout = DEFAULT_DATA.about;
            }

            renderCategories();
            renderGallery();
            renderAboutContent();
        }

        function renderAboutContent() {
            if (siteAbout) {
                if (aboutTitle && siteAbout.title) aboutTitle.textContent = siteAbout.title;
                if (aboutSubtitle && siteAbout.subtitle) aboutSubtitle.textContent = siteAbout.subtitle;
                if (aboutDescription && Array.isArray(siteAbout.description)) {
                    aboutDescription.innerHTML = siteAbout.description.map(p => `<p>${p}</p>`).join('');
                }
            }
        }

        function renderCategories() {
            const categories = ["Semua", ...new Set(certificates.map(c => c.category).filter(Boolean))];

            categoryContainer.innerHTML = categories.map(cat => {
                const isActive = cat === activeCategory;
                const activeClasses = isActive 
                    ? 'bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 border-zinc-900 dark:border-zinc-100 shadow-xs font-semibold' 
                    : 'bg-white dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 font-medium';
                
                return `
                    <button onclick="setCategory('${cat}')" class="px-3 py-1 text-xs rounded-full border transition-all duration-150 ${activeClasses}">
                        ${cat}
                    </button>
                `;
            }).join('');
        }

        function setCategory(cat) {
            activeCategory = cat;
            renderCategories();
            renderGallery();
        }

        function renderGallery() {
            const filtered = certificates.filter(cert => {
                const matchesCategory = activeCategory === "Semua" || cert.category === activeCategory;
                const matchesSearch = cert.title.toLowerCase().includes(searchQuery.toLowerCase()) || 
                                     (cert.category && cert.category.toLowerCase().includes(searchQuery.toLowerCase()));
                return matchesCategory && matchesSearch;
            });

            certCounter.textContent = `${filtered.length} Sertifikat`;

            if (filtered.length === 0) {
                galleryGrid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');

            galleryGrid.innerHTML = filtered.map(cert => `
                <div onclick="openModal('${cert.id}')" 
                     class="group relative bg-white dark:bg-[#121215] border border-zinc-200/90 dark:border-zinc-800/90 rounded-xl overflow-hidden cursor-pointer hover:border-zinc-400 dark:hover:border-zinc-600 transition-all duration-200 flex flex-col shadow-xs">
                    
                    <div class="relative cert-aspect bg-zinc-100 dark:bg-zinc-900/80 overflow-hidden flex items-center justify-center border-b border-zinc-100 dark:border-zinc-800/60">
                        <img src="${cert.imageUrl}" 
                             alt="${cert.title}" 
                             loading="lazy" 
                             onerror="this.onerror=null; this.src='https://placehold.co/600x424/e2e8f0/475569?text=Sertifikat';"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 ease-out">
                        
                        <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center">
                            <span class="bg-white/90 dark:bg-zinc-900/90 text-zinc-900 dark:text-zinc-100 text-[10px] sm:text-xs font-semibold px-2.5 py-1 rounded-full shadow-md backdrop-blur-xs">
                                Lihat Detail
                            </span>
                        </div>
                    </div>

                    <div class="p-2.5 sm:p-3 flex-1 flex flex-col justify-between">
                        <div>
                            <span class="inline-block text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-0.5">
                                ${cert.category || 'Umum'}
                            </span>
                            <h3 class="text-xs sm:text-sm font-semibold text-zinc-800 dark:text-zinc-200 line-clamp-2 leading-snug group-hover:text-zinc-900 dark:group-hover:text-white transition-colors">
                                ${cert.title}
                            </h3>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Certificate Modal Handlers
        function openModal(id) {
            const cert = certificates.find(c => c.id === id);
            if (!cert) return;

            modalTitle.textContent = cert.title;
            modalCategory.textContent = cert.category || 'Umum';

            modalLoader.classList.remove('hidden');
            modalImage.onload = () => modalLoader.classList.add('hidden');
            modalImage.onerror = () => {
                modalLoader.classList.add('hidden');
                modalImage.src = 'https://placehold.co/800x600/e2e8f0/475569?text=Gagal+Memuat+Gambar';
            };
            modalImage.src = cert.imageUrl;

            showModal(certModal);
        }

        function closeModal() {
            hideModal(certModal);
        }

        // About Modal Handlers (Slower smooth tick animation: 2400ms)
        function animateCounter(elementId, targetValue, duration = 2400) {
            const el = document.getElementById(elementId);
            if (!el) return;
            let start = 0;
            const startTime = performance.now();

            function update(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                // Smooth ease-out quad formula
                const currentVal = Math.floor(progress * (2 - progress) * targetValue);
                el.textContent = currentVal.toLocaleString('id-ID');

                if (progress < 1) {
                    requestAnimationFrame(update);
                } else {
                    el.textContent = targetValue.toLocaleString('id-ID');
                }
            }
            requestAnimationFrame(update);
        }

        function openAboutModal() {
            showModal(aboutModal);
            animateCounter('statWeekly', siteStats.weekly);
            animateCounter('statMonthly', siteStats.monthly);
            animateCounter('statYearly', siteStats.yearly);
        }

        function closeAboutModal() {
            hideModal(aboutModal);
        }

        // Contact / WhatsApp Modal Handlers
        function openContactModal() {
            showModal(contactModal);
        }

        function closeContactModal() {
            hideModal(contactModal);
        }

        // Helper Functions for Modals (Instant Blur activation)
        function showModal(modalEl) {
            modalEl.classList.remove('opacity-0', 'pointer-events-none');
            const content = modalEl.querySelector('.transform');
            if (content) {
                content.classList.remove('scale-95');
                content.classList.add('scale-100');
            }
            document.body.classList.add('overflow-hidden');
        }

        function hideModal(modalEl) {
            modalEl.classList.add('opacity-0', 'pointer-events-none');
            const content = modalEl.querySelector('.transform');
            if (content) {
                content.classList.remove('scale-100');
                content.classList.add('scale-95');
            }
            document.body.classList.remove('overflow-hidden');
        }

        // WhatsApp Form Submit Event
        whatsappForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const nameInput = document.getElementById('senderName').value.trim();
            const messageInput = document.getElementById('senderMessage').value.trim();

            const senderName = nameInput ? nameInput : 'Hamba Allah';
            const text = `Halo Nash Studio,\n\nSaya: ${senderName}\nPertanyaan: ${messageInput}`;
            
            const whatsappUrl = `https://wa.me/6285640366256?text=${encodeURIComponent(text)}`;
            window.open(whatsappUrl, '_blank');
            closeContactModal();
            whatsappForm.reset();
        });

        // Global Event Listeners
        closeModalBtn.addEventListener('click', closeModal);
        modalBackdrop.addEventListener('click', closeModal);

        aboutToggleBtn.addEventListener('click', openAboutModal);
        closeAboutBtn.addEventListener('click', closeAboutModal);
        aboutBackdrop.addEventListener('click', closeAboutModal);

        fabBtn.addEventListener('click', openContactModal);
        closeContactBtn.addEventListener('click', closeContactModal);
        contactBackdrop.addEventListener('click', closeContactModal);

        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeModal();
                closeAboutModal();
                closeContactModal();
            }
        });

        searchInput.addEventListener('input', (e) => {
            searchQuery = e.target.value;
            renderGallery();
        });

        window.onload = function() {
            initTheme();
            loadCertificates();
        };
    </script>
</body>
</html>
